<Page
    x:Class="GameStore.ShopPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GameStore">
    <Grid Padding="20" ColumnSpacing="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="3*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="CATÁLOGO" Style="{StaticResource SectionTitleStyle}" />
                <Rectangle Width="40" Height="4" RadiusX="2" RadiusY="2" Fill="{StaticResource GreenBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <GridView x:Name="CatalogList" Grid.Row="1" SelectionMode="Single" DoubleTapped="CatalogList_DoubleTapped"
                      ItemContainerStyle="{StaticResource CardContainerStyle}"
                      Background="#660A0A0F" BorderBrush="{StaticResource PurpleBrush}" BorderThickness="1" CornerRadius="12"
                      Padding="6">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="local:Videogame">
                        <Border Width="170" Background="{StaticResource PanelBrush}" CornerRadius="10"
                                BorderBrush="{StaticResource PurpleBrush}" BorderThickness="1">
                            <StackPanel>
                                <Border Height="235" CornerRadius="10,10,0,0">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{x:Bind Cover}" Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                                <Rectangle Height="2" Fill="{StaticResource GoldBrush}" />
                                <StackPanel Padding="10,8,10,10" Spacing="2">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="{x:Bind Platform}" FontSize="12" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                    <Grid Margin="0,4,0,0">
                                        <TextBlock Text="{x:Bind PriceText}" FontWeight="Bold" FontSize="16"
                                                   Foreground="{StaticResource GoldLightBrush}" />
                                        <TextBlock Text="{x:Bind StockText}" FontSize="12" HorizontalAlignment="Right"
                                                   VerticalAlignment="Bottom" Foreground="{StaticResource GreenBrush}" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
                <NumberBox x:Name="QuantityBox" Header="Cantidad" Width="160" Minimum="1" Maximum="99" Value="1"
                           SmallChange="1" SpinButtonPlacementMode="Inline" />
                <Button Content="Agregar al carrito" VerticalAlignment="Bottom" Style="{StaticResource AccentButtonStyle}"
                        Click="Add_Click" />
                <TextBlock Text="Tip: doble clic en una carátula para agregarla" VerticalAlignment="Bottom" Margin="8,0,0,6"
                           FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
            </StackPanel>

            <TextBlock Grid.Row="3" Text="CARRITO DE COMPRA" Margin="0,12,0,0" Style="{StaticResource SectionTitleStyle}" />
            <ListView x:Name="CartList" Grid.Row="4" SelectionMode="Single" BorderThickness="1" CornerRadius="12"
                      Background="#660A0A0F" BorderBrush="{StaticResource PurpleBrush}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:TicketLine">
                        <Grid ColumnSpacing="12" Padding="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <Border Width="44" Height="62" CornerRadius="6" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1">
                                <Border.Background>
                                    <ImageBrush ImageSource="{x:Bind Cover}" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="{x:Bind DetailText}" VerticalAlignment="Center" HorizontalAlignment="Right"
                                       Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Grid.Column="3" Text="{x:Bind SubtotalText}" VerticalAlignment="Center" HorizontalAlignment="Right"
                                       FontWeight="Bold" Foreground="{StaticResource GoldLightBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="12">
                <Button Content="Quitar seleccionado" Click="Remove_Click" />
                <Button Content="Vaciar carrito" Click="Clear_Click" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Column="1">
            <StackPanel Spacing="10">
                <Border Style="{StaticResource PanelBorderStyle}" BorderBrush="{StaticResource GoldBrush}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="ClientText" Style="{StaticResource SectionTitleStyle}" />
                        <TextBox x:Name="PaymentBox" Header="Pago del cliente (MXN)" MaxLength="10"
                                 BeforeTextChanging="Payment_BeforeTextChanging" LostFocus="Payment_LostFocus" />
                        <TextBlock x:Name="PaymentError" Foreground="#FF6B6B" TextWrapping="Wrap" />
                        <TextBlock x:Name="SubtotalText" Foreground="{StaticResource TextBrush}" />
                        <TextBlock x:Name="DiscountText" Foreground="{StaticResource GreenBrush}" />
                        <TextBlock x:Name="TaxText" Foreground="{StaticResource TextMutedBrush}" />
                        <Rectangle Height="1" Fill="{StaticResource PurpleBrush}" Margin="0,4" />
                        <TextBlock x:Name="TotalText" Style="{StaticResource SubtitleTextBlockStyle}"
                                   Foreground="{StaticResource GoldLightBrush}" FontWeight="Bold" />
                        <Button Content="Confirmar compra y generar ticket" HorizontalAlignment="Stretch" Margin="0,6,0,0"
                                Style="{StaticResource AccentButtonStyle}" Click="Checkout_Click" />
                    </StackPanel>
                </Border>

                <TextBox x:Name="TicketBox" Header="Ticket" Height="320" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
                         Background="#0A0A0F" Foreground="{StaticResource GreenBrush}"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                <Button Content="Cerrar sesión" HorizontalAlignment="Stretch" Click="Logout_Click" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
