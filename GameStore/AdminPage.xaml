<Page
    x:Class="GameStore.AdminPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GameStore">
    <Grid Padding="20" ColumnSpacing="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Text="PANEL DE ADMINISTRADOR" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock x:Name="WelcomeText" Foreground="{StaticResource TextMutedBrush}" />
            </StackPanel>

            <ListView x:Name="CatalogList" Grid.Row="1" SelectionMode="Single" BorderThickness="1" CornerRadius="12"
                      Background="#660A0A0F" BorderBrush="{StaticResource PurpleBrush}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:Videogame">
                        <Grid ColumnSpacing="12" Padding="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <Border Width="52" Height="74" CornerRadius="6" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1">
                                <Border.Background>
                                    <ImageBrush ImageSource="{x:Bind Cover}" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{x:Bind Id}" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Title}" VerticalAlignment="Center" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="3" Text="{x:Bind Platform}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Grid.Column="4" Text="{x:Bind PriceText}" VerticalAlignment="Center" HorizontalAlignment="Right"
                                       FontWeight="Bold" Foreground="{StaticResource GoldLightBrush}" />
                            <TextBlock Grid.Column="5" Text="{x:Bind StockText}" VerticalAlignment="Center" HorizontalAlignment="Right"
                                       Foreground="{StaticResource GreenBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Bottom">
                <Button Content="Eliminar seleccionado" VerticalAlignment="Bottom" Click="RemoveGame_Click" />
                <Button Content="Cambiar carátula" VerticalAlignment="Bottom" Click="ChangeCover_Click" />
                <NumberBox x:Name="StockIncreaseBox" Header="Unidades a agregar" Width="190" Minimum="1" Maximum="1000"
                           Value="1" SmallChange="1" LargeChange="10" SpinButtonPlacementMode="Inline" />
                <Button Content="Aumentar stock" VerticalAlignment="Bottom" Style="{StaticResource AccentButtonStyle}"
                        Click="IncreaseStock_Click" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Column="1">
            <StackPanel Spacing="12">
                <Border Style="{StaticResource PanelBorderStyle}" BorderBrush="{StaticResource GoldBrush}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Agregar videojuego" Style="{StaticResource SectionTitleStyle}" />
                        <TextBox x:Name="TitleBox" Header="Título" MaxLength="60" />
                        <TextBox x:Name="PlatformBox" Header="Plataforma" MaxLength="30" Text="Xbox Series X|S" />
                        <TextBox x:Name="PriceBox" Header="Precio (MXN)" MaxLength="10" BeforeTextChanging="Price_BeforeTextChanging" />
                        <TextBox x:Name="StockBox" Header="Stock inicial" MaxLength="6" BeforeTextChanging="Stock_BeforeTextChanging" />

                        <TextBlock Text="Carátula (obligatoria)" Foreground="{StaticResource GoldBrush}" FontSize="12" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="100" Height="145" CornerRadius="8" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1">
                                <Border.Background>
                                    <ImageBrush x:Name="CoverPreviewBrush" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                                <Button Content="Elegir carátula..." HorizontalAlignment="Stretch" Click="PickCover_Click" />
                                <TextBlock x:Name="CoverNameText" Text="Ninguna imagen seleccionada" TextWrapping="Wrap"
                                           FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>
                        </Grid>

                        <Button Content="Agregar al catálogo" HorizontalAlignment="Stretch" Margin="0,6,0,0"
                                Style="{StaticResource AccentButtonStyle}" Click="AddGame_Click" />
                    </StackPanel>
                </Border>
                <Button Content="Cerrar sesión" HorizontalAlignment="Stretch" Margin="0,12,0,0" Click="Logout_Click" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
