<ContentDialog
    x:Class="GameStore.RegisterDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Crear cuenta"
    PrimaryButtonText="Crear cuenta"
    CloseButtonText="Cancelar"
    DefaultButton="Primary"
    PrimaryButtonClick="Create_Click">
    <StackPanel Width="320" Spacing="12">
        <TextBox x:Name="UsernameBox" Header="Usuario" MaxLength="30" />
        <PasswordBox x:Name="PasswordInput" Header="Contraseña" MaxLength="30" />
        <PasswordBox x:Name="ConfirmInput" Header="Confirmar contraseña" MaxLength="30" />
        <TextBlock x:Name="ErrorText" Foreground="#FF6B6B" TextWrapping="Wrap" />
    </StackPanel>
</ContentDialog>
